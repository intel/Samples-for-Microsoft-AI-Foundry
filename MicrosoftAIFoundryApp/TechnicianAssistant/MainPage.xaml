<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechnicianAssistant.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechnicianAssistant"
    xmlns:vm="using:TechnicianAssistant.ViewModels"
    xmlns:converters="using:TechnicianAssistant.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <ThemeShadow />
                </Setter.Value>
            </Setter>
        </Style>

        <converters:RecordingIconColorConverter x:Key="RecordingIconColorConverter"/>

        <!-- Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{ThemeResource AccentButtonForeground}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrush}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Title Text Style -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App Title Bar -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <FontIcon
                    Glyph="&#xE90F;"
                    FontSize="32"
                    Foreground="{ThemeResource SystemAccentColor}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Text="Technician Assistant"
                        Style="{StaticResource TitleTextBlockStyle}"
                        FontWeight="Bold"/>
                    <TextBlock
                        Text="AI-Powered Field Service Support"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    CornerRadius="6"
                    Click="SystemLogsMenuItem_Click"
                    ToolTipService.ToolTip="View system logs">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FD;" FontSize="15"/>
                        <TextBlock Text="System Logs" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    CornerRadius="6"
                    Click="TokenUsageMenuItem_Click"
                    ToolTipService.ToolTip="View token usage and cost estimate">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B9;" FontSize="15"/>
                        <TextBlock Text="Token Usage" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <TabView
            Grid.Row="1"
            x:Name="MainTabView"
            TabWidthMode="Equal"
            IsAddTabButtonVisible="False"
            CanDragTabs="False"
            CanReorderTabs="False">

            <TabView.TabItems>

                <!-- Equipment Details Tab -->
                <TabViewItem>
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B3;" FontSize="18"/>
                            <TextBlock
                                Text="Equipment Details"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabViewItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="32,24" Spacing="24">

                                <!-- Page Header -->
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Text="Equipment Details"
                                        Style="{StaticResource TitleLargeTextBlockStyle}"
                                        FontWeight="Bold"/>
                                    <TextBlock
                                        Text="Upload an equipment image for OCR analysis"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Action Card -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="16">
                                        <TextBlock
                                            Text="Select Image"
                                            Style="{StaticResource SectionTitleStyle}"/>

                                        <Button
                                            Command="{x:Bind ViewModel.EquipmentDetails.SelectImageCommand}"
                                            IsEnabled="{x:Bind ViewModel.EquipmentDetails.IsProcessing, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            MinWidth="160">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="18"/>
                                                <TextBlock Text="Browse Files" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Processing Indicator -->
                                        <InfoBar
                                            IsOpen="{x:Bind ViewModel.EquipmentDetails.IsProcessing, Mode=OneWay}"
                                            Severity="Informational"
                                            IsClosable="False">
                                            <InfoBar.Content>
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <ProgressRing IsActive="True" Width="20" Height="20"/>
                                                    <TextBlock Text="Processing image..." VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </InfoBar.Content>
                                        </InfoBar>

                                        <!-- Cloud image analysis &#x2014; visible after local OCR extraction completes -->
                                        <InfoBar
                                            IsOpen="{x:Bind ViewModel.EquipmentDetails.HasLocalExtractionResult, Mode=OneWay}"
                                            Severity="Warning"
                                            IsClosable="False"
                                            Title="Want a more accurate result?"
                                            Message="The local scan is done, but the cloud model can often read tricky or worn labels more reliably. Give it a try if the details don't look right.">
                                            <InfoBar.ActionButton>
                                                <Button
                                                    Content="&#x2601;&#xFE0F;  Try Cloud Analysis"
                                                    Command="{x:Bind ViewModel.EquipmentDetails.AnalyzeWithCloudCommand}"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                            </InfoBar.ActionButton>
                                        </InfoBar>
                                    </StackPanel>
                                </Border>

                                <!-- Image Preview + Equipment Info side by side -->
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="280"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Image Preview Card -->
                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon
                                                    Glyph="&#xEB9F;"
                                                    FontSize="20"
                                                    Foreground="{ThemeResource SystemAccentColor}"/>
                                                <TextBlock
                                                    Text="Image Preview"
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Margin="0"/>
                                            </StackPanel>

                                            <Border
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                MinHeight="340">
                                                <Grid>
                                                    <Image
                                                        Source="{x:Bind ViewModel.EquipmentDetails.CapturedImage, Mode=OneWay}"
                                                        Stretch="Uniform"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="16"/>
                                                    <StackPanel
                                                        Visibility="{x:Bind ViewModel.EquipmentDetails.CapturedImage, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="16">
                                                        <FontIcon
                                                            Glyph="&#xEB9F;"
                                                            FontSize="64"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        <TextBlock
                                                            Text="No image selected yet"
                                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock
                                                            Text="Select an image file to begin analysis"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Equipment Info Card -->
                                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                                        <StackPanel Spacing="20">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon
                                                    Glyph="&#xE8EC;"
                                                    FontSize="20"
                                                    Foreground="{ThemeResource SystemAccentColor}"/>
                                                <TextBlock
                                                    Text="Equipment Information"
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Margin="0"/>
                                            </StackPanel>

                                            <!-- Spinner shown while extracting -->
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{x:Bind ViewModel.EquipmentDetails.IsExtractingModel, Mode=OneWay}">
                                                <ProgressRing IsActive="True" Width="16" Height="16"/>
                                                <TextBlock
                                                    Text="Extracting&#x2026;"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource SystemAccentColor}"
                                                    VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Model Number -->
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    Text="Model No."
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.EquipmentDetails.ModelNumber, Mode=OneWay}"
                                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                                    FontWeight="SemiBold"
                                                    IsTextSelectionEnabled="True"
                                                    TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                                            <!-- Serial Number -->
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    Text="Serial No."
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.EquipmentDetails.SerialNumber, Mode=OneWay}"
                                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                                    FontWeight="SemiBold"
                                                    IsTextSelectionEnabled="True"
                                                    TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Border
                                                Height="1"
                                                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Visibility="{x:Bind ViewModel.EquipmentDetails.ExtractionSource, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>

                                            <!-- Extraction source badge -->
                                            <StackPanel
                                                Spacing="4"
                                                Visibility="{x:Bind ViewModel.EquipmentDetails.ExtractionSource, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                                                <TextBlock
                                                    Text="Processed by"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.EquipmentDetails.ExtractionSource, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource SystemAccentColor}"
                                                    TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- Ask Assistant Tab -->
                <TabViewItem>
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE720;" FontSize="18"/>
                            <TextBlock
                                Text="Ask Assistant"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabViewItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="900"/>
                        </Grid.ColumnDefinitions>

                        <!-- Main Content Area -->
                        <Grid Grid.Column="0" Margin="24,16,24,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Page Header -->
                            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                                <TextBlock
                                    Text="Ask Assistant"
                                    Style="{StaticResource TitleLargeTextBlockStyle}"
                                    FontWeight="Bold"/>
                                <TextBlock
                                    Text="Type a question or use your voice to get AI-powered answers from technical manuals"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <!-- Equipment context banner &#x2014; visible once model/serial are identified -->
                                <InfoBar
                                    IsOpen="{x:Bind ViewModel.VoiceSupport.HasEquipmentContext, Mode=OneWay}"
                                    Severity="Success"
                                    IsClosable="False"
                                    Title="Active Equipment"
                                    Message="{x:Bind ViewModel.VoiceSupport.EquipmentContextSummary, Mode=OneWay}"
                                    Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Conversation history -->
                            <Border
                                Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Padding="0"
                                Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid
                                        Grid.Row="0"
                                        Padding="20,16,20,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                            <FontIcon
                                                Glyph="&#xE8F2;"
                                                FontSize="20"
                                                Foreground="{ThemeResource SystemAccentColor}"/>
                                            <TextBlock
                                                Text="Conversation"
                                                Style="{StaticResource SectionTitleStyle}"
                                                Margin="0"/>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Command="{x:Bind ViewModel.VoiceSupport.ClearConversationCommand}"
                                            VerticalAlignment="Center"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="Clear conversation history">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE894;" FontSize="13"/>
                                                <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ScrollViewer
                                        Grid.Row="1"
                                        x:Name="ConversationScrollViewer"
                                        VerticalScrollBarVisibility="Auto"
                                        Padding="20,0,20,20">
                                        <TextBlock
                                            x:Name="ConversationTextBlock"
                                            Text="{x:Bind ViewModel.VoiceSupport.ConversationHistory, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True"
                                            FontSize="15"
                                            LineHeight="26"
                                            Style="{StaticResource BodyTextBlockStyle}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Manual snippet highlight &#x2014; visible when a verbatim passage was found -->
                            <Border
                                Grid.Row="2"
                                Visibility="{x:Bind ViewModel.VoiceSupport.HasKeySnippet, Mode=OneWay}"
                                BorderBrush="#FF2563EB"
                                BorderThickness="0,0,4,0"
                                CornerRadius="6"
                                Padding="16,12"
                                Margin="0,0,0,12">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE736;" FontSize="14" Foreground="#FF2563EB"/>
                                        <TextBlock
                                            Text="Verbatim from the manual"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#FF2563EB"/>
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.VoiceSupport.KeySnippet, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        FontSize="14"
                                        FontStyle="Italic"
                                        IsTextSelectionEnabled="True"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Input area -->
                            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">

                                    <TextBlock
                                        Text="{x:Bind ViewModel.VoiceSupport.AssistantResponse, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemAccentColor}"
                                        Visibility="{x:Bind ViewModel.VoiceSupport.IsProcessing, Mode=OneWay}"
                                        TextWrapping="Wrap"/>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="QueryTextBox"
                                            Grid.Column="0"
                                            Text="{x:Bind ViewModel.VoiceSupport.TextInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Type your question, or tap &#x1F3A4; to speak&#x2026;  (Enter to send &#xB7; Shift+Enter for new line)"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            MinHeight="80"
                                            VerticalContentAlignment="Top"
                                            IsReadOnly="{x:Bind ViewModel.VoiceSupport.IsProcessing, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.VoiceSupport.IsModelsReady, Mode=OneWay}"
                                            PreviewKeyDown="QueryTextBox_KeyDown"/>

                                        <Button
                                            Grid.Column="1"
                                            Command="{x:Bind ViewModel.VoiceSupport.AttachFileCommand}"
                                            IsEnabled="{x:Bind ViewModel.VoiceSupport.IsModelsReady, Mode=OneWay}"
                                            Width="44" Height="44"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="Attach image file (sent to cloud only)">
                                            <FontIcon Glyph="&#xE723;" FontSize="18"/>
                                        </Button>

                                        <Button
                                            Grid.Column="2"
                                            Command="{x:Bind ViewModel.VoiceSupport.ToggleRecordingCommand}"
                                            IsEnabled="{x:Bind ViewModel.VoiceSupport.IsModelsReady, Mode=OneWay}"
                                            Width="44" Height="44"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.VoiceSupport.RecordingButtonText, Mode=OneWay}">
                                            <FontIcon
                                                Glyph="{x:Bind ViewModel.VoiceSupport.IsRecording, Converter={StaticResource RecordingIconConverter}, Mode=OneWay}"
                                                Foreground="{x:Bind ViewModel.VoiceSupport.IsRecording, Converter={StaticResource RecordingIconColorConverter}, Mode=OneWay}"
                                                FontSize="18"/>
                                        </Button>

                                        <Button
                                            Grid.Column="3"
                                            Command="{x:Bind ViewModel.VoiceSupport.SubmitTextCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Width="44" Height="44"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="Send (Enter)">
                                            <FontIcon Glyph="&#xE724;" FontSize="18"/>
                                        </Button>
                                    </Grid>

                                    <!-- Attachment strip &#x2014; only visible when files are attached -->
                                    <Grid Visibility="{x:Bind ViewModel.VoiceSupport.HasAttachments, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                Text="&#x1F4CE; Attachments (sent to cloud only)"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock
                                                Text="{x:Bind ViewModel.VoiceSupport.AttachmentSummary, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SystemAccentColor}"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Command="{x:Bind ViewModel.VoiceSupport.ClearAttachmentsCommand}"
                                            ToolTipService.ToolTip="Remove all attachments"
                                            Width="32" Height="32" Padding="0"
                                            VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8BB;" FontSize="12"/>
                                        </Button>
                                    </Grid>

                                    <!-- Thin audio level bar &#x2014; only shown while recording -->
                                    <ProgressBar
                                        Value="{x:Bind ViewModel.VoiceSupport.AudioLevel, Mode=OneWay}"
                                        Maximum="1.0"
                                        Minimum="0.0"
                                        Height="3"
                                        CornerRadius="2"
                                        Visibility="{x:Bind ViewModel.VoiceSupport.IsRecording, Mode=OneWay}"/>

                                    <TextBlock
                                        Visibility="{x:Bind ViewModel.VoiceSupport.IsRecording, Mode=OneWay}"
                                        Text="&#x1F3D9;&#xFE0F; Recording&#x2026; speak clearly, then tap the mic button to stop"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemAccentColor}"/>

                                    <InfoBar
                                        IsOpen="{x:Bind ViewModel.VoiceSupport.IsProcessing, Mode=OneWay}"
                                        Severity="Informational"
                                        IsClosable="False">
                                        <InfoBar.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ProgressRing IsActive="True" Width="16" Height="16"/>
                                                <TextBlock Text="Processing&#x2026;" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </InfoBar.Content>
                                    </InfoBar>

                                    <!-- Cloud escalation &#x2014; visible after the local model answers -->
                                    <InfoBar
                                        IsOpen="{x:Bind ViewModel.VoiceSupport.HasLocalResponse, Mode=OneWay}"
                                        Severity="Warning"
                                        IsClosable="False"
                                        Title="Not satisfied with the answer?"
                                        Message="Escalate this question to the cloud model for a second opinion.">
                                        <InfoBar.ActionButton>
                                            <Button
                                                Content="&#x2601;&#xFE0F;  Ask Cloud"
                                                Command="{x:Bind ViewModel.VoiceSupport.AskCloudCommand}"
                                                Style="{StaticResource AccentButtonStyle}"/>
                                        </InfoBar.ActionButton>
                                    </InfoBar>

                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Right Side Panel: PDF Viewer -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Panel header -->
                            <Border
                                Grid.Row="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,1"
                                Padding="20,14">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xEA90;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}"/>
                                        <TextBlock Text="Service Manual" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock
                                        Text="Opens automatically when a relevant manual page is found"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- PDF WebView or empty state -->
                            <Border
                                Grid.Row="1"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                                <Grid>
                                    <!-- Empty state &#x2014; no PDF yet -->
                                    <StackPanel
                                        Visibility="{x:Bind ViewModel.VoiceSupport.HasPdfSource, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="16">
                                        <FontIcon Glyph="&#xEA90;" FontSize="64" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock
                                            Text="No manual loaded yet"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center"/>
                                        <TextBlock
                                            Text="Ask a question &#x2014; the relevant manual page will appear here automatically"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="280"
                                            TextAlignment="Center"/>
                                    </StackPanel>

                                    <!-- PDF loaded state &#x2014; WebView2 renders the file -->
                                    <WebView2
                                        x:Name="ManualWebView"
                                        Visibility="{x:Bind ViewModel.VoiceSupport.HasPdfSource, Mode=OneWay}"/>
                                </Grid>
                            </Border>

                            <!-- Open-in-viewer button + page label -->
                            <Border
                                Grid.Row="2"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,1,0,0"
                                Padding="16,10"
                                Visibility="{x:Bind ViewModel.VoiceSupport.HasPdfSource, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="Page "/>
                                        <Run Text="{x:Bind ViewModel.VoiceSupport.CurrentPdfPage, Mode=OneWay}"/>
                                        <Run Text=" &#xB7; most relevant section highlighted"/>
                                    </TextBlock>
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.VoiceSupport.OpenPdfCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
